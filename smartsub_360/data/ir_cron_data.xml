<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Automated Recurring Billing Cron Engine -->
    <record id="ir_cron_smartsub_recurring_billing" model="ir.cron">
        <field name="name">SmartSub 360: Recurring Invoicing Engine</field>
        <field name="model_id" ref="model_smartsub_contract"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_recurring_invoices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

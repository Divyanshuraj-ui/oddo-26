<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_smartsub_360" model="ir.module.category">
        <field name="name">SmartSub 360</field>
        <field name="description">Manage subscription contracts, recurring billing, and plans.</field>
        <field name="sequence">25</field>
    </record>

    <!-- User Group -->
    <record id="group_smartsub_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_smartsub_360"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager / Administrator Group -->
    <record id="group_smartsub_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_smartsub_360"/>
        <field name="implied_ids" eval="[(4, ref('group_smartsub_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-Company Record Rules -->
    <record id="smartsub_contract_company_rule" model="ir.rule">
        <field name="name">SmartSub Contract Multi-Company</field>
        <field name="model_id" ref="model_smartsub_contract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="smartsub_plan_company_rule" model="ir.rule">
        <field name="name">SmartSub Plan Multi-Company</field>
        <field name="model_id" ref="model_smartsub_plan"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

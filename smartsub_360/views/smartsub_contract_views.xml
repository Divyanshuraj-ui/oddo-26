<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Contract List View -->
    <record id="view_smartsub_contract_list" model="ir.ui.view">
        <field name="name">smartsub.contract.list</field>
        <field name="model">smartsub.contract</field>
        <field name="arch" type="xml">
            <list string="Subscription Contracts"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'paused'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="next_invoice_date"/>
                <field name="end_date"/>
                <field name="recurring_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"
                       decoration-muted="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Subscription Contract Form View -->
    <record id="view_smartsub_contract_form" model="ir.ui.view">
        <field name="name">smartsub.contract.form</field>
        <field name="model">smartsub.contract</field>
        <field name="arch" type="xml">
            <form string="Subscription Contract">
                <header>
                    <button name="action_activate" string="Start Subscription" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_pause" string="Pause" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_activate" string="Resume" type="object" class="oe_highlight"
                            invisible="state != 'paused'"/>
                    <button name="action_close" string="Close Contract" type="object"
                            invisible="state in ('closed', 'draft')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'closed'"
                            groups="smartsub_360.group_smartsub_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Contract Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Subscriber &amp; Plan">
                            <field name="partner_id" context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="plan_id"/>
                            <field name="recurring_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Schedule &amp; Terms">
                            <field name="start_date"/>
                            <field name="next_invoice_date"/>
                            <field name="end_date"/>
                            <field name="auto_renew"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Notes" name="notes">
                            <field name="description" placeholder="Specify any SLA rules, customer conditions, or custom discount agreements..."/>
                        </page>
                        <page string="Invoices" name="invoices">
                            <field name="invoice_ids" readonly="1">
                                <list string="Invoices">
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="smartsub_period_start"/>
                                    <field name="smartsub_period_end"/>
                                    <field name="amount_total_signed" string="Total"/>
                                    <field name="payment_state" widget="badge"
                                           decoration-success="payment_state in ('paid', 'in_payment')"
                                           decoration-warning="payment_state == 'not_paid'"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'posted'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Subscription Contract Search View: minimal Odoo 19-compatible definition -->
    <record id="view_smartsub_contract_search" model="ir.ui.view">
        <field name="name">smartsub.contract.search</field>
        <field name="model">smartsub.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="state_active" domain="[('state', '=', 'active')]"/>
                <filter string="Paused" name="state_paused" domain="[('state', '=', 'paused')]"/>
                <filter string="Closed" name="state_closed" domain="[('state', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <!-- Action for Contracts -->
    <record id="action_smartsub_contract" model="ir.actions.act_window">
        <field name="name">Subscription Contracts</field>
        <field name="res_model">smartsub.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_smartsub_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first subscription contract!
            </p>
            <p>
                Track active recurring agreements, scheduled billing dates, and invoices.
            </p>
        </field>
    </record>
</odoo>

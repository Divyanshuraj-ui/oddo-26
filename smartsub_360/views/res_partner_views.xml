<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_smartsub_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.smartsub.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_smartsub_contracts"
                        icon="fa-repeat">
                    <field string="Subscriptions" name="smartsub_contract_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
